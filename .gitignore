# 의존성 패키지 폴더 (명시적 경로 - 우선 적용)
frontend/node_modules
backend/node_modules

# 추가 안전장치 (다른 위치의 node_modules도 대비)
**/node_modules

# 빌드 결과물
**/dist
**/build

# 로그 파일
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# 운영체제 생성 파일
.DS_Store
Thumbs.db

# 에디터 및 IDE 설정 폴더
.idea
.vscode/

# 환경 변수 파일 (민감 정보 포함 가능)
# 모든 .env* 파일을 무시하되, .env.example 파일은 예외로 함
.env*
!*.env.example
!**/.env.example

# Python 가상환경 / 캐시
venv/
.venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]

# 에디터 백업 파일
*~
